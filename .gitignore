# ---------------------------------------------------------------- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ------------------------------------------------------------------ venvs ---
.venv/
venv/
env/
sae-venv/

# ----------------------------------------------------------------- macOS ---
.DS_Store

# -------------------------------------------------- model weights (huge) ---
# Never commit model weights — download them per the README (Stability AI
# licenses; not redistributable here).
*.ckpt
*.safetensors
*.pt
*.pth
*.bin
weights/
models/

# ------------------------------------------------- mined arrays / outputs ---
# Distribution caches and raw embeddings are large binaries — regenerate them
# with the mining scripts; don't commit them. (Curated demo PNGs live in
# assets/, which is NOT ignored.)
*.npz
*.npy
outputs/
art_experiment.png
object_experiment.png

# ------------------------------------------------------- AI session scratch ---
_ai_sessions/

# ------------------------------------------------ dropped experiments ---
# Earlier standalone experiments are excluded entirely from this repo. The SDXL
# backend now lives in the package via STOCK diffusers pipelines
# (semantic_anarchy/pipeline.py + backend.py). Left on disk (a process may be
# running there) but never committed.
sdxl_sae/
requirements-sdxl.txt
licenses/
NOTICE
EXPLORE.md

# user-provided init images (img2img entropy injection)
init_images/

# ------------------------------------------------------------- web frontend ---
# The dashboard's React app: sources are committed, installed deps and the
# build output are not (webui/app.py serves dist/ when it exists).
webui/frontend/node_modules/
webui/frontend/dist/

# The dashboard's hand-picked checkpoint paths (sidebar model picker). Absolute
# paths to weights on *this* machine, so they're per-user: pick your models once
# in the UI rather than committing someone else's layout.
webui/model_config.json

# The dashboard's selected base distribution (sidebar "Select base
# distribution"). Points at a corpus / .npz on *this* machine — per-user, like
# the checkpoint picks above.
webui/dist_config.json

# A prompt corpus's fitted latents live beside the .txt (the .npz itself is
# already ignored; this is its metadata sidecar).
*__*.meta.json

# Prompt corpora harvested off this machine's old SD experiment folders.
# Personal material, gathered for reading, not code. prompts_filtered/ is the
# SD-only, explicit-stripped, de-duplicated cut of prompt_files/.
prompt_files/
prompts_filtered/
